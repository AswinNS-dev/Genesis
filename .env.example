DATABASE_URL="file:./dev.db"
NEXTAUTH_SECRET="your-secret-here"
NEXTAUTH_URL="http://localhost:3000"
AI_MODE="mock"
AI_API_KEY=""
UPLOAD_DIR="./public/uploads"

# ── Supabase (optional, enables PostgreSQL database + Storage) ────────────────
# Get these from https://supabase.com/dashboard → project → Settings → API
# To run everything on Supabase: set DATABASE_URL to the Postgres connection
# string (Prisma format) and supply STORAGE_DRIVER="supabase" (or it is inferred
# automatically when DATABASE_URL is Postgres).
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-anon-public-key"
# SERVICE ROLE KEY: server-side ONLY. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
# Storage bucket where evidence/documents are stored.
SUPABASE_STORAGE_BUCKET="crimeintel-evidence"
SUPABASE_STORAGE_PUBLIC="true"
# Storage driver: "local" (default) or "supabase" (auto-inferred from DATABASE_URL)
STORAGE_DRIVER="local"
