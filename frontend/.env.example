# CrimeIntel — frontend environment template
# Copy to `frontend/.env` and fill in real values. This file is gitignored.
DATABASE_URL="file:./dev.db"
NEXTAUTH_SECRET="your-secret-here"
NEXTAUTH_URL="http://localhost:3000"
AI_MODE="mock"
AI_API_KEY=""
UPLOAD_DIR="./public/uploads"

# ── Supabase (optional, enables PostgreSQL database + Storage + Auth) ────────
# Get these from https://supabase.com/dashboard → project → Settings → API
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
# SERVICE ROLE KEY: server-side ONLY. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="crimeintel-evidence"
SUPABASE_STORAGE_PUBLIC="true"
STORAGE_DRIVER="local"

# ── Supabase client (public anon key, shipped to the browser for sign-in) ────
# Required only for the client-side Supabase Auth sign-in path. Safe to expose.
NEXT_PUBLIC_SUPABASE_URL="${SUPABASE_URL}"
NEXT_PUBLIC_SUPABASE_ANON_KEY="${SUPABASE_ANON_KEY}"